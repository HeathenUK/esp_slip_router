@ECHO OFF
REM mTCP+FOSSLIP+SLIP -- accepts URL as arg; default is internet 1MB.
C:
CD \TDONGLE
ECHO Started at %TIME% > P-MTCP.LOG
SET MTCPCFG=C:\TDONGLE\MTCP.CFG
USBTERM.EXE -s TO-SLIP.TXT -l TO-SLIP-RX.LOG COM1 9600
FOSSLIP.EXE 0x60 1 115200 >> P-MTCP.LOG
IF "%1"=="" GOTO DEFAULT
MTCPGET.EXE -v -o GOT.BIN %1 >> P-MTCP.LOG
GOTO POST
:DEFAULT
MTCPGET.EXE -v -o GOT.BIN http://ipv4.download.thinkbroadband.com/1MB.zip >> P-MTCP.LOG
:POST
C:\MTCP\PKTTOOL.EXE stats >> P-MTCP.LOG
MAGICOUT.EXE COM1 >> P-MTCP.LOG
ECHO Ended at %TIME% >> P-MTCP.LOG
TYPE P-MTCP.LOG
